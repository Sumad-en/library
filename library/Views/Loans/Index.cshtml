@model List<LoanView>

@{
    ViewData["Title"] = "Loans";

    var totalLoans = Model.Count;
    var overdueLoans = Model.Count(x => x.Status == "Overdue");
    var activeLoans = Model.Count(x => x.ReturnedOn == null);
    var returnedLoans = Model.Count(x => x.ReturnedOn != null);
}

<div class="container py-4">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row
        justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">Loan Management</h2>
            <p class="text-muted mb-0">
                Manage borrowed books and track return dates.
            </p>
        </div>

        <a asp-action="Borrow"
           class="btn btn-primary btn-lg rounded-3">
            <i class="bi bi-plus-lg me-2"></i>
            Borrow a Book
        </a>

    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <!-- Total Loans -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between
                        align-items-center mb-3">
                        <span class="text-muted small fw-semibold">
                            TOTAL LOANS
                        </span>
                        <div class="bg-primary bg-opacity-10
                            text-primary rounded-3 p-2">
                            <i class="bi bi-journal-bookmark fs-5"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-0">@totalLoans</h3>
                    <small class="text-muted">All loan records</small>
                </div>
            </div>
        </div>

        <!-- Active Loans -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between
                        align-items-center mb-3">
                        <span class="text-muted small fw-semibold">
                            ACTIVE LOANS
                        </span>
                        <div class="bg-warning bg-opacity-10
                            text-warning rounded-3 p-2">
                            <i class="bi bi-clock-history fs-5"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-0">@activeLoans</h3>
                    <small class="text-muted">Not yet returned</small>
                </div>
            </div>
        </div>

        <!-- Overdue Loans -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between
                        align-items-center mb-3">
                        <span class="text-muted small fw-semibold">
                            OVERDUE
                        </span>
                        <div class="bg-danger bg-opacity-10
                            text-danger rounded-3 p-2">
                            <i class="bi bi-exclamation-circle fs-5"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-0">@overdueLoans</h3>
                    <small class="text-muted">Past due date</small>
                </div>
            </div>
        </div>

        <!-- Returned Loans -->
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex justify-content-between
                        align-items-center mb-3">
                        <span class="text-muted small fw-semibold">
                            RETURNED
                        </span>
                        <div class="bg-success bg-opacity-10
                            text-success rounded-3 p-2">
                            <i class="bi bi-check-circle fs-5"></i>
                        </div>
                    </div>

                    <h3 class="fw-bold mb-0">@returnedLoans</h3>
                    <small class="text-muted">Successfully returned</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Loans Table -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-2 mb-4">

                <div>
                    <h5 class="fw-bold mb-1">Loan Records</h5>
                    <p class="text-muted small mb-0">
                        Showing @totalLoans loans, newest first.
                    </p>
                </div>

                <span class="badge bg-light text-dark border
                    rounded-pill px-3 py-2">
                    <i class="bi bi-list-ul me-1"></i>
                    All Records
                </span>

            </div>

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="py-3">Member</th>
                            <th class="py-3">Book</th>
                            <th class="py-3">Loaned On</th>
                            <th class="py-3">Due Date</th>
                            <th class="py-3">Status</th>
                            <th class="py-3 text-end">Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var loan in Model)
                            {
                                <tr>
                                    <!-- Member -->
                                    <td>
                                        <div class="d-flex align-items-center
                                            gap-2">
                                            <div class="bg-primary
                                                bg-opacity-10
                                                text-primary
                                                rounded-circle
                                                d-flex
                                                align-items-center
                                                justify-content-center"
                                                 style="width:38px;
                                                height:38px;">
                                                <i class="bi bi-person"></i>
                                            </div>

                                            <span class="fw-semibold">
                                                @loan.MemberName
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Book -->
                                    <td>
                                        <div class="d-flex align-items-center
                                            gap-2">
                                            <i class="bi bi-book
                                            text-muted fs-5"></i>
                                            <span>
                                                @loan.BookTitle
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Loaned Date -->
                                    <td class="text-muted">
                                        @loan.LoanedOn.ToString("MMM dd, yyyy")
                                    </td>

                                    <!-- Due Date -->
                                    <td class="fw-semibold">
                                        @loan.LoanedOn.AddDays(loan.DaysAllowed).ToString("MMM dd, yyyy")                                                                         
                                    </td>

                                    <!-- Status -->
                                    <td>
                                        @if (loan.Status == "Overdue")
                                        {
                                            <span class="badge
                                                bg-danger bg-opacity-10
                                                text-danger rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-exclamation-circle
                                                me-1"></i>
                                                Overdue
                                            </span>
                                        }
                                        else if (loan.Status == "Out")
                                        {
                                            <span class="badge
                                                bg-warning bg-opacity-10
                                                text-warning rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-clock
                                                me-1"></i>
                                                Out
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                bg-success bg-opacity-10
                                                text-success rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-check-circle
                                                me-1"></i>
                                                @loan.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- Action -->
                                    <td class="text-end">
                                        @if (loan.ReturnedOn == null)
                                        {
                                            <form asp-action="Return"
                                                  asp-route-id="@loan.LoanId"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-sm
                                                    btn-outline-success
                                                    rounded-3">
                                                    <i class="bi bi-arrow-return-left
                                                    me-1"></i>
                                                    Return
                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-check2-all
                                                me-1"></i>
                                                Completed
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="mb-3">
                                        <i class="bi bi-journal-x
                                        text-muted"
                                           style="font-size:3rem;"></i>
                                    </div>

                                    <h6 class="fw-bold">
                                        No loan records found
                                    </h6>

                                    <p class="text-muted small mb-3">
                                        There are currently no borrowing
                                        transactions.
                                    </p>

                                    <a asp-action="Borrow"
                                       class="btn btn-primary rounded-3">
                                        <i class="bi bi-plus-lg me-2"></i>
                                        Borrow a Book
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-4">
        <p class="text-muted small">
            <i class="bi bi-shield-check me-1"></i>
            Library Management System
        </p>
    </div>

</div>