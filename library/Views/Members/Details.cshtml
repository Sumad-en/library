@model MemberDetails

@{
    ViewData["Title"] = Model.Member.full_name;

    var totalLoans = Model.Loans.Count;
    var activeLoans = Model.Loans.Count(x => x.ReturnedOn == null);
    var returnedLoans = Model.Loans.Count(x => x.ReturnedOn != null);
    var overdueLoans = Model.Loans.Count(x => x.Status == "Overdue");
}

<div class="container py-4">

    <!-- Back Navigation -->
    <div class="mb-4">
        <a asp-action="Index"
           class="text-decoration-none text-muted small">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Members
        </a>
    </div>

    <!-- Member Profile Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <div class="d-flex flex-column flex-md-row
                align-items-md-center gap-3">

                <!-- Avatar -->
                <div class="bg-primary bg-opacity-10 text-primary
                    rounded-circle d-flex align-items-center
                    justify-content-center"
                     style="width:80px;height:80px;">

                    <i class="bi bi-person-fill"
                       style="font-size:2.5rem;"></i>

                </div>

                <!-- Member Name -->
                <div class="flex-grow-1">

                    <span class="text-muted small fw-semibold">
                        MEMBER PROFILE
                    </span>

                    <h2 class="fw-bold mb-2">
                        @Model.Member.full_name
                    </h2>

                    <span class="badge bg-primary bg-opacity-10
                        text-primary rounded-pill px-3 py-2">
                        <i class="bi bi-person-badge me-1"></i>
                        @Model.Member.member_type
                    </span>

                </div>

            </div>

            <hr class="my-4">

            <!-- Member Information -->
            <h5 class="fw-bold mb-3">
                <i class="bi bi-info-circle text-primary me-2"></i>
                Member Information
            </h5>

            <div class="row g-3">

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">

                        <div class="text-muted small mb-2">
                            <i class="bi bi-person me-2"></i>
                            Full Name
                        </div>

                        <div class="fw-semibold">
                            @Model.Member.full_name
                        </div>

                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">

                        <div class="text-muted small mb-2">
                            <i class="bi bi-envelope me-2"></i>
                            Email Address
                        </div>

                        <div class="fw-semibold">
                            @(Model.Member.email ?? "No email provided")
                        </div>

                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-light rounded-3 p-3 h-100">

                        <div class="text-muted small mb-2">
                            <i class="bi bi-people me-2"></i>
                            Member Type
                        </div>

                        <div class="fw-semibold">
                            @Model.Member.member_type
                        </div>

                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- Borrowing Statistics -->
    <div class="mb-4">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-bar-chart-line text-primary me-2"></i>
            Borrowing Overview
        </h5>

        <div class="row g-3">

            <!-- Total Loans -->
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4">

                        <div class="text-primary mb-2">
                            <i class="bi bi-journal-bookmark fs-4"></i>
                        </div>

                        <h3 class="fw-bold mb-0">
                            @totalLoans
                        </h3>

                        <small class="text-muted">
                            Total Loans
                        </small>

                    </div>
                </div>
            </div>

            <!-- Active Loans -->
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4">

                        <div class="text-warning mb-2">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>

                        <h3 class="fw-bold mb-0">
                            @activeLoans
                        </h3>

                        <small class="text-muted">
                            Active Loans
                        </small>

                    </div>
                </div>
            </div>

            <!-- Overdue Loans -->
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4">

                        <div class="text-danger mb-2">
                            <i class="bi bi-exclamation-circle fs-4"></i>
                        </div>

                        <h3 class="fw-bold mb-0">
                            @overdueLoans
                        </h3>

                        <small class="text-muted">
                            Overdue Loans
                        </small>

                    </div>
                </div>
            </div>

            <!-- Returned Loans -->
            <div class="col-6 col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-3 p-md-4">

                        <div class="text-success mb-2">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>

                        <h3 class="fw-bold mb-0">
                            @returnedLoans
                        </h3>

                        <small class="text-muted">
                            Returned Books
                        </small>

                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Borrowing History -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-3 p-md-4">

            <div class="d-flex flex-column flex-md-row
                justify-content-between align-items-md-center
                gap-2 mb-4">

                <div>
                    <h5 class="fw-bold mb-1">
                        <i class="bi bi-book-half text-primary me-2"></i>
                        Borrowing History
                    </h5>

                    <p class="text-muted small mb-0">
                        Complete borrowing records for this member.
                    </p>
                </div>

                <span class="badge bg-light text-dark border
                    rounded-pill px-3 py-2">
                    @totalLoans Records
                </span>

            </div>

            @if (Model.Loans.Count == 0)
            {
                <!-- Empty State -->
                <div class="text-center py-5">

                    <div class="text-muted mb-3">
                        <i class="bi bi-journal-x"
                           style="font-size:3.5rem;"></i>
                    </div>

                    <h5 class="fw-bold">
                        No Borrowing History
                    </h5>

                    <p class="text-muted mb-0">
                        This member has never borrowed a book.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="py-3">Book</th>
                                <th class="py-3">Loaned On</th>
                                <th class="py-3">Returned On</th>
                                <th class="py-3">Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var loan in Model.Loans)
                            {
                                <tr>

                                    <!-- Book -->
                                    <td>
                                        <div class="d-flex align-items-center
                                            gap-2">

                                            <div class="bg-primary
                                                bg-opacity-10
                                                text-primary
                                                rounded-3 p-2">
                                                <i class="bi bi-book"></i>
                                            </div>

                                            <span class="fw-semibold">
                                                @loan.BookTitle
                                            </span>

                                        </div>
                                    </td>

                                    <!-- Loaned -->
                                    <td class="text-muted">
                                        @loan.LoanedOn.ToString("MMM dd, yyyy")
                                    </td>

                                    <!-- Returned -->
                                    <td class="text-muted">
                                        @(loan.ReturnedOn?.ToString("MMM dd, yyyy") ?? "Not returned")
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (loan.Status == "Overdue")
                                        {
                                            <span class="badge
                                                bg-danger bg-opacity-10
                                                text-danger rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-exclamation-circle
                                                me-1"></i>
                                                Overdue
                                            </span>
                                        }
                                        else if (loan.Status == "Out")
                                        {
                                            <span class="badge
                                                bg-warning bg-opacity-10
                                                text-warning rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-clock
                                                me-1"></i>
                                                Out
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge
                                                bg-success bg-opacity-10
                                                text-success rounded-pill
                                                px-3 py-2">
                                                <i class="bi bi-check-circle
                                                me-1"></i>
                                                @loan.Status
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

    <!-- Footer -->
    <div class="text-center mt-4">
        <a asp-action="Index"
           class="btn btn-light rounded-3 px-4">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Members
        </a>
    </div>

    <p class="text-center text-muted small mt-3">
        <i class="bi bi-shield-check me-1"></i>
        Library Management System
    </p>

</div>