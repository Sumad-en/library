@model List<Members>
@{
    ViewData["full_name"] = "Members";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Members</h1>
        <p class="text-muted mb-0">@Model.Count members in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a member</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Full name</th>
            <th>Member Type</th>
            <th class="text-end">mail</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var members in Model)
        {
            {
                <tr>
                    <td class="text-end">@members.member_id</td>
                    <td>@members.full_name</td>
                    <td><span class="badge text-bg-secondary">@(members.member_type ?? "—")</span></td>
                    <td class="text-end">@(members.email)</td>                
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@members.member_id" class="btn btn-sm btn-outline-primary">Loans</a>
                        <a asp-action="Edit" asp-route-id="@members.member_id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-controller="Members" asp-action="Delete" asp-route-id="@members.member_id" method="post" onsubmit="return confirm('Are you sure you want to delete this member?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

