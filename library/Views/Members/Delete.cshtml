@model Members
@{
    ViewData["Members"] = "Delete a member";
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<h1 class="mb-3">Delete a member</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this member?</p>
    <dl class="row mb-2">
        <dt class="col-4">full_name</dt>
        <dd class="col-8">@Model.full_name</dd>
        <dt class="col-4">email</dt>
        <dd class="col-8">@(Model.email ?? "—")</dd>
        <dt class="col-4">member_type</dt>
        <dd class="col-8">@(Model.member_type)</dd>
    </dl>
    <p class="text-muted small">Any member with an active loan will not be deleted.</p>

    <!-- The updated form mapping to [HttpPost] controller action -->
    <form asp-controller="Members" asp-action="Delete" asp-route-id="@Model.member_id" method="post">
        @Html.AntiForgeryToken()

        <!-- Explicit input named 'id' ensures it binds directly to (long id) in your C# method -->
        <input type="hidden" name="id" value="@Model.member_id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
