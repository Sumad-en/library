@model Members
@{
    ViewData["Members"] = "Delete a member";
}

<h1 class="mb-3">Delete a member</h1>

<div class="card card-body" style="max-width:36rem">

    <p>Are you sure you want to delete this member?</p>
    <dl class="row mb-2">
        <dt class="col-4">full_name</dt>
        <dd class="col-8">@Model.full_name</dd>
        <dt class="col-4">email</dt>
        <dd class="col-8">@(Model.email ?? "—")</dd>
        <dt class="col-4">member_type</dt>
        <dd class="col-8">@(Model.member_type ?? "—")</dd>
    </dl>
    <p class="text-muted small">Any loans of this book are deleted with it.</p>

    <form asp-action="Delete" asp-route-id="@Model.member_id" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
