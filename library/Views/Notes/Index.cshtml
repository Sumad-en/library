@model List<Notes>
@{
    ViewData["Title"] = "Notes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Notes</h1>
        <p class="text-muted mb-0">@Model.Count Notes in the catalogue</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a note</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th class="text-end" style="width:4rem">#</th>
            <th>Title</th>
            <th>Body</th>
            <th class="text-end">Created On</th>
            <th style="width:10rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var notes in Model)
        {
            <tr>
                <td class="text-end">@notes.note_id</td>
                <td>@notes.title</td>
                <td><span class="badge text-bg-secondary">@(notes.body ?? "—")</span></td>
                <td class="text-end">@(notes.created_on.Date)</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@notes.note_id" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@notes.note_id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

